# Voxline AI Core Configuration
# Copy this file to .env and fill in your values

# ============================================================
# AI Provider Configuration
# ============================================================

# Which AI provider to use: local_hf (a model folder on this machine)
AI_PROVIDER=local_hf

# Local model paths (for local provider)
AI_MODEL_PATH=models/Qwen2.5-0.5B-Instruct
AI_TOKENIZER_PATH=checkpoints/voxline_tokenizer_v0_3.json

# Device: auto|cpu|cuda|mps
AI_DEVICE=auto

# Data type: float32|float16|bfloat16
AI_DTYPE=float32

# ============================================================
# External AI Provider Keys (only if using external providers)
# DO NOT commit these to version control
# ============================================================

# OpenAI
# OPENAI_API_KEY=sk-...

# Google Gemini
# GEMINI_API_KEY=AIzaSy...

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# Web Search Configuration
# ============================================================

# Search provider: duckduckgo|google|bing
# WEB_SEARCH_PROVIDER=duckduckgo
# WEB_SEARCH_API_KEY=

# ============================================================
# Video Generation (Future)
# ============================================================

# VIDEO_PROVIDER=
# VIDEO_API_KEY=

# ============================================================
# Instagram Integration (Future)
# ============================================================

# INSTAGRAM_PROVIDER=meta
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID=

# ============================================================
# Workspace & Projects
# ============================================================

# Root workspace directory
WORKSPACE_ROOT=.

# Projects directory
PROJECTS_ROOT=./projects

# Maximum project size in MB
MAX_PROJECT_SIZE_MB=1000

# ============================================================
# Database Configuration
# ============================================================

# Database URL
# SQLite: sqlite:///./voxline.db
# PostgreSQL: postgresql://user:password@localhost/voxline
DATABASE_URL=sqlite:///./voxline.db

# Log SQL queries (development only)
DATABASE_ECHO=false

# ============================================================
# Logging Configuration
# ============================================================

# Log level: DEBUG|INFO|WARNING|ERROR|CRITICAL
LOG_LEVEL=INFO

# Log format: text|json
LOG_FORMAT=text

# ============================================================
# API Configuration
# ============================================================

# API host
API_HOST=0.0.0.0

# API port
API_PORT=8000

# Debug mode
API_DEBUG=false

# ============================================================
# Environment
# ============================================================

# Environment: development|staging|production
ENVIRONMENT=development
