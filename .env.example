# Voxline AI Core Configuration
# Copy this file to .env and fill in your values

# ============================================================
# AI Provider Configuration
# ============================================================

# Which AI provider to use:
#   local_hf  -> (retired) see QWEN_DEPLOYMENT.md
#   qwen      -> local Qwen2.5 model folder on this machine (default; local only)
#   native    -> local native Voxline model (local only)
#   openai    -> hosted OpenAI-compatible API (REQUIRED for Vercel/serverless)
AI_PROVIDER=qwen

# Local model paths (for local providers qwen/native ONLY — not usable on Vercel)
AI_MODEL_PATH=models/Qwen2.5-0.5B-Instruct
AI_TOKENIZER_PATH=checkpoints/voxline_tokenizer_v0_3.json

# Device: auto|cpu|cuda|mps  (local providers only)
AI_DEVICE=auto

# Data type: float32|float16|bfloat16  (local providers only)
AI_DTYPE=float32

# ============================================================
# Hosted (OpenAI-compatible) provider — used on Vercel/serverless
# Set AI_PROVIDER=openai to use these.
# These values are REQUIRED for the hosted provider.
# The API key is a SECRET: set it server-side in Vercel only.
# NEVER commit it, NEVER put it in a browser, NEVER log it.
# ============================================================
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo


# ============================================================
# External AI Provider Keys (only if using external providers)
# DO NOT commit these to version control
# ============================================================

# OpenAI
# OPENAI_API_KEY=sk-...

# Google Gemini
# GEMINI_API_KEY=AIzaSy...

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# Web Search Configuration
# ============================================================

# Search provider: duckduckgo|google|bing
# WEB_SEARCH_PROVIDER=duckduckgo
# WEB_SEARCH_API_KEY=

# ============================================================
# Video Generation (Future)
# ============================================================

# VIDEO_PROVIDER=
# VIDEO_API_KEY=

# ============================================================
# Instagram Integration (Future)
# ============================================================

# INSTAGRAM_PROVIDER=meta
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_ID=

# ============================================================
# Workspace & Projects
# ============================================================

# Root workspace directory
WORKSPACE_ROOT=.

# Projects directory
PROJECTS_ROOT=./projects

# Maximum project size in MB
MAX_PROJECT_SIZE_MB=1000

# ============================================================
# Database Configuration
# ============================================================

# Database URL
# SQLite: sqlite:///./voxline.db
# PostgreSQL: postgresql://user:password@localhost/voxline
DATABASE_URL=sqlite:///./voxline.db

# Log SQL queries (development only)
DATABASE_ECHO=false

# ============================================================
# Logging Configuration
# ============================================================

# Log level: DEBUG|INFO|WARNING|ERROR|CRITICAL
LOG_LEVEL=INFO

# Log format: text|json
LOG_FORMAT=text

# ============================================================
# API Configuration
# ============================================================

# API host
API_HOST=0.0.0.0

# API port
API_PORT=8000

# Debug mode
API_DEBUG=false

# ============================================================
# Environment
# ============================================================

# Environment: development|staging|production
ENVIRONMENT=development
